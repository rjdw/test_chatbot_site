# testing
test/

# secrets / local env
.dev.vars
.env*

# ─── Node & package managers ──────────────────────────
node_modules/
npm-debug.log*
yarn.lock
pnpm-lock.yaml
package-lock.json
.DS_Store

# ─── Build output ─────────────────────────────────────
# /public is fully generated: `npm run build` rebuilds every file in it
# (vite bundles + copies src/public/* verbatim, incl. _redirects).
# Committing it caused permanent dirty-tree / merge-conflict pain.
# NOTE: root-anchored on purpose — src/public/ is source and IS tracked.
/public/

# Generated post/media HTML (scripts/build-posts.js writes these from
# src/posts/*.md and src/public/content.json before vite runs).
src/posts/*.html
!src/posts/_template.html
src/media/*.html

# ─── Tailwind/JIT cache ───────────────────────────────
.tailwind-cache/
.postcss-cache/

# ─── Cloudflare Wrangler ──────────────────────────────
.wrangler
./.wrangler/**
.env
.env.*

# ─── IDE / OS clutter ─────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
.settings/
*.log

src/styles.css
